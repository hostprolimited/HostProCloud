[Unit]
Description=HostPro Cloud - Multi-Cluster Manager for Proxmox VE
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=hostpro
Group=hostpro
WorkingDirectory=/var/lib/hostpro
ExecStart=/usr/bin/hostpro/hostpro-wrapper

Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hostpro

[Install]
WantedBy=multi-user.target
